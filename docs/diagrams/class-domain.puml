@startuml class-domain
title Class-01 – Domain class diagram (BrewLite)
hide empty methods
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class User {
  - id: UUID
  - email: string «unique»
  - passwordHash: string
  - fullName: string
  - phone: string [0..1]
  - role: UserRole
  - createdAt: timestamp
}
class Category {
  - id: UUID
  - name: string «unique»
  - displayOrder: int
}
class Product {
  - id: UUID
  - name: string
  - description: string
  - basePrice: int (VND)
  - imageUrl: string [0..1]
  - stockQuantity: int ≥ 0
  - isAvailable: boolean
  - createdAt: timestamp
  - updatedAt: timestamp
}
class Size {
  - id: UUID
  - name: string (S/M/L)
  - extraPrice: int (VND)
}
class Topping {
  - id: UUID
  - name: string «unique»
  - extraPrice: int (VND)
  - isAvailable: boolean
}
class Order {
  - id: UUID
  - status: OrderStatus
  - subtotal: int (VND)
  - discountAmount: int (VND)
  - totalAmount: int (VND)
  - note: string [0..1]
  - createdAt: timestamp
  - updatedAt: timestamp
}
class OrderItem {
  - id: UUID
  - productName: string «snapshot»
  - sizeName: string «snapshot»
  - unitPrice: int «snapshot»
  - quantity: int ≥ 1
  - lineTotal: int (VND)
}
class OrderItemTopping {
  - id: UUID
  - toppingName: string «snapshot»
  - extraPrice: int «snapshot»
}
class Payment {
  - id: UUID
  - method: PaymentMethod
  - status: PaymentStatus
  - amount: int (VND)
  - idempotencyKey: string «unique»
  - providerRef: string [0..1]
  - failureReason: string [0..1]
  - createdAt: timestamp
}
class Promotion {
  - id: UUID
  - code: string «unique»
  - discountType: DiscountType
  - discountValue: int
  - minOrderAmount: int
  - startsAt: timestamp
  - endsAt: timestamp
  - usageLimit: int [0..1]
  - isActive: boolean
}
class LoyaltyTransaction {
  - id: UUID
  - type: LoyaltyType
  - points: int
  - createdAt: timestamp
}
enum UserRole {
  CUSTOMER
  STAFF
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  WALLET
  CARD
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}
enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}
enum LoyaltyType {
  EARN
  REDEEM
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
OrderItem "1" *-- "0..*" OrderItemTopping : has
OrderItemTopping "0..*" --> "1" Topping : refers to
OrderItem "0..*" --> "1" Product : refers to
OrderItem "0..*" --> "1" Size : chosen size
Order "1" -- "0..*" Payment : paid by
Promotion "0..1" -- "0..*" Order : applied to
User "1" -- "0..*" LoyaltyTransaction : owns
Order "0..1" -- "0..*" LoyaltyTransaction : generates
Category "1" -- "0..*" Product : groups
Product "1" *-- "1..*" Size : offers
Product "0..*" -- "0..*" Topping : allows

User ..> UserRole
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Promotion ..> DiscountType
LoyaltyTransaction ..> LoyaltyType

' «snapshot» = sao chép tên/giá tại thời điểm đặt để đơn cũ không đổi khi menu thay đổi
@enduml
