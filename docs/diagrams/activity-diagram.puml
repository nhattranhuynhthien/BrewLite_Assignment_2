@startuml
skinparam DefaultTextAlignment center
skinparam ActivityBackgroundColor #3498DB
skinparam ActivityBorderColor #2980B9
skinparam ActivityFontColor White
skinparam SwimlaneBorderColor #333333

|Hệ thống|
start
:Xem menu sản phẩm (FR-01);
:Xem chi tiết sản phẩm, size, topping và tồn kho (FR-04, FR-05, FR-07);

|Khách hàng|
:Chọn số lượng, tùy chọn và thêm vào giỏ hàng (FR-10, FR-11);
:Chỉnh sửa hoặc quản lý giỏ hàng tạm tính (FR-12, FR-13, FR-14);
:Bấm nút đặt hàng / thanh toán;

|Hệ thống|
:Kiểm tra trạng thái đăng nhập và JWT hợp lệ (FR-22);

if (Đã đăng nhập và JWT hợp lệ?) then (Chưa / Không hợp lệ)
    |Hệ thống|
    :Hiển thị giao diện đăng nhập;
    |Khách hàng|
    repeat :Nhập thông tin tài khoản, mật khẩu;
        |Hệ thống|
        :Xác thực tài khoản và kiểm tra mật khẩu (FR-21);
    repeat while (Thông tin đúng?) is (Sai / Không hợp lệ)
    
    |Hệ thống|
    :Cấp mã JWT và giữ nguyên giỏ hàng (FR-14, FR-21);
else (Đã đăng nhập)
endif

|Hệ thống|
:Tạo đơn hàng (PENDING_PAYMENT), tính lại giá, lưu snapshot và trừ tồn kho sản phẩm trong Transaction (FR-25, FR-26);

if (Đủ tồn kho / Thành công?) then (Hết hàng / Lỗi)
    :Rollback transaction, trả lỗi 409 Out of Stock;
    :Giữ nguyên giỏ hàng để khách điều chỉnh;
    stop
else (Đủ hàng)
    :Hiển thị hóa đơn và giao diện thanh toán (FR-28, FR-33);
    
    |Khách hàng|
    :Thực hiện thanh toán Ví/Thẻ mô phỏng kèm Idempotency-Key (FR-28, FR-29);
    
    |Hệ thống|
    :Kiểm tra kết quả cổng thanh toán (FR-30, FR-31);
    
    if (Kết quả thanh toán?) then (Thành công - SUCCESS)
        :Cập nhật trạng thái đơn thành PAID (FR-30);
        :Thông báo thanh toán thành công (FR-33);
        
        |Nhân viên quầy (STAFF)|
        :Nhân viên nhận đơn, cập nhật PAID -> PREPARING -> READY -> COMPLETED (FR-24, FR-37, FR-38);
        
        |Khách hàng|
        :Xem lịch sử và theo dõi trạng thái đơn (FR-35, FR-36);
        :Nhận đồ uống tại quầy;
        stop
        
    elseif (Thất bại - FAILED) then (Từ chối / Lỗi)
        |Hệ thống|
        :Cập nhật trạng thái đơn thành PAYMENT_FAILED (FR-30);
        :Hoàn lại tồn kho đã trừ đúng một lần (FR-30);
        :Thông báo thanh toán thất bại (FR-33);
        :Yêu cầu khách hàng tạo đơn mới từ giỏ hàng nếu muốn thử lại;
        stop
        
    else (Timeout / Chưa rõ kết quả)
        |Hệ thống|
        :Payment giữ PENDING, đơn giữ PENDING_PAYMENT (FR-31);
        :Tiến hành đối soát trạng thái theo Idempotency-Key cũ (FR-31);
        stop
    endif
endif
@enduml