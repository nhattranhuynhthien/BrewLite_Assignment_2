@startuml
skinparam DefaultTextAlignment center
skinparam ActivityBackgroundColor #3498DB
skinparam ActivityBorderColor #2980B9
skinparam ActivityFontColor White
skinparam SwimlaneBorderColor #333333

|Hệ thống|
start
:Mở menu nước;

|Khách hàng|
:Chọn món / Thêm vào giỏ;

|Hệ thống|
:Kiểm tra nguyên vật liệu (FR-07)[cite: 6];
if (Đủ nguyên vật liệu?) then (Không)
    :Thông báo hết đồ uống / Thiếu hàng;
    stop
else (Có)
    :Hiển thị chi tiết sản phẩm, size, topping (FR-04, FR-05)[cite: 6];
    :Kiểm tra trạng thái đăng nhập (FR-21)[cite: 6];
    
    if (Đã đăng nhập?) then (Chưa đăng nhập)
        |Khách hàng|
        :Hiển thị giao diện đăng nhập;
        :Nhập tài khoản, mật khẩu;
        
        |Hệ thống|
        :Kiểm tra thông tin xác thực JWT (FR-21, FR-22)[cite: 6];
        if (Hợp lệ?) then (Sai)
            :Thông báo đăng nhập thất bại;
            stop
        else (Đúng)
        endif
    else (Đã đăng nhập)
    endif
    
    |Hệ thống|
    :Yêu cầu xác nhận thông tin đồ uống & tổng tiền tạm tính (FR-14)[cite: 6];
    
    |Khách hàng|
    if (Lựa chọn?) then (Chọn Hủy)
        |Hệ thống|
        :Hủy thao tác / Giữ giỏ hàng ở client;
        stop
    else (Chọn Xác nhận / Đặt đơn)
        |Hệ thống|
        :Tạo đơn hàng (PENDING_PAYMENT), tạo dòng đơn & trừ tồn kho trong Transaction (FR-30, FR-32)[cite: 6];
        :Hiển thị hóa đơn thanh toán (FR-33)[cite: 6];
        
        |Khách hàng|
        :Thực hiện thanh toán (Ví/Thẻ mô phỏng tự động) (FR-33)[cite: 6];
        
        |Hệ thống|
        :Kiểm tra kết quả cổng thanh toán (FR-34, FR-35)[cite: 6];
        
        if (Thanh toán thành công?) then (Thành công)
            :Cập nhật trạng thái đơn: PAID -> Tự động chuyển PREPARING (FR-35)[cite: 6];
            :Thông báo thanh toán thành công & tiến hành pha chế tự động;
            :Thông báo hoàn thành (READY) khi xong đồ;
            
            |Khách hàng|
            :Nhận đồ uống tại quầy tự động;
            stop
        else (Thất bại / Lỗi)
            |Hệ thống|
            :Cập nhật trạng thái đơn: PAYMENT_FAILED (FR-35)[cite: 6];
            :Hoàn lại tồn kho đã trừ đúng một lần (FR-35)[cite: 6];
            :Thông báo thanh toán thất bại (FR-38)[cite: 6];
            :Yêu cầu khách tạo đơn mới từ giỏ hàng;
            stop
        endif
    endif
endif
@enduml