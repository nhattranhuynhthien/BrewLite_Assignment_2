# Local development / Docker Compose defaults (DO NOT put real production secrets here)
NODE_ENV=development
PORT=4000
API_PORT=4000

# PostgreSQL
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_local_dev_pw
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brewlite:brewlite_local_dev_pw@localhost:5432/brewlite?schema=public
TEST_DATABASE_URL=postgresql://brewlite:brewlite_local_dev_pw@localhost:5432/brewlite_test?schema=public

# Auth & CORS
JWT_SECRET=replace_with_your_local_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Seed demo accounts (ignored in production unless explicitly true)
SEED_DEMO_USERS=true

# Mock Payment Gateway
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace_with_your_local_webhook_secret
PAYMENT_TIMEOUT_MS=5000
MOCK_PAYMENT_DELAY_MS=0

# Frontend Next.js public variables (never place secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCK=false
