# ==========================================
# CẤU HÌNH CHUNG (ENVIRONMENT)
# ==========================================
NODE_ENV=development

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password_local
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Chuỗi kết nối dùng cho ORM (Prisma / TypeORM) ở apps/api
DATABASE_URL="postgresql://brewlite_user:brewlite_password_local@localhost:5432/brewlite_db?schema=public"

# Chuỗi kết nối dành riêng cho Integration Test (Issue I-28 / I-38)
TEST_DATABASE_URL="postgresql://brewlite_user:brewlite_password_local@localhost:5432/brewlite_test_db?schema=public"

# ==========================================
# BACKEND API (NestJS - apps/api)
# ==========================================
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT Authentication (Chỉ dùng giá trị mẫu cho local, tuyệt đối không dùng cho Production)
JWT_SECRET=replace_with_your_local_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1d

# Cấu hình dịch vụ thanh toán mô phỏng (Mock Payment Service)
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_local

# ==========================================
# FRONTEND WEB (Next.js - apps/web)
# ==========================================
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000