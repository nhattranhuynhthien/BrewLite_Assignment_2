{
  "name": "@brewlite/api",
  "version": "0.1.0",
  "private": true,
  "description": "BrewLite modular monolith REST API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:integration": "node scripts/test-integration.cjs",
    "prisma:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "bcryptjs": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3",
    "@types/express": "^5.0.3",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
